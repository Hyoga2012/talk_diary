# OpenAI (음성 인식 + 분류에 필요)
OPENAI_API_KEY=sk-...

# 선택: 모델 오버라이드
# OPENAI_WHISPER_MODEL=whisper-1
# OPENAI_CLASSIFY_MODEL=gpt-4o-mini

# Supabase (클라우드 저장)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL (Google OAuth 콜백용) — 로컬 예: http://localhost:3000
# 배포 예: https://talk-diary.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Calendar + Tasks (읽기 전용 가져오기)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 비우면 NEXT_PUBLIC_APP_URL + /api/google/callback 사용
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# GOOGLE_TOKEN_SECRET=랜덤문자열
